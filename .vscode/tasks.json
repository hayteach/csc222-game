{
    "tasks": [
        {
            "type": "shell",
            "label": "Build: cross-platform",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "${workspaceFolder}/scripts/run_build.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Cross-platform build launcher: attempts python3 then python, falls back to platform scripts."
        },
        {
            "type": "shell",
            "label": "C/C++: build project (wildcard, skip mains)",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "${workspaceFolder}/scripts/build_project.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Builds all source files (wildcard) but automatically skips files that define main()."
        },

        {
            "type": "shell",
            "label": "CMake: configure",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake: build (dungeongame)",
            "command": "cmake",
            "args": ["--build", "build", "--target", "dungeongame_exe"],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}