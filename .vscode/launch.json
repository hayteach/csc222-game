    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug dungeongame (LLDB - MacOS/Linux)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/dungeongame",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: cross-platform",
            "terminal": "integrated",
            "sourceLanguages": ["cpp"]
        },
        {
            "name": "Debug dungeongame (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/dungeongame",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: cross-platform",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "externalConsole": false
        },
        {
            "name": "Debug dungeongame (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/${file}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: cross-platform",
            "externalConsole": false
        }
    ]
}